# =====================================================================
# Copie para .env (desenvolvimento) ou configure no provedor de deploy.
# NUNCA versione o arquivo .env. Apenas NEXT_PUBLIC_* chegam ao navegador.
# =====================================================================

# --- Aplicação ---
# URL pública do site (https obrigatório em produção). Usada nas back_urls do
# Mercado Pago e na proteção CSRF (validação de Origin).
APP_URL=http://localhost:3000

# Trava de vendas. Só mude para "true" após confirmar: disponibilidade comercial,
# autorização para revenda, plataformas oficiais e dados legais da loja.
SALES_ENABLED=false

# Fuso horário do processo (apenas local/Docker; a Vercel não permite definir TZ).
# A interface já formata as datas explicitamente em America/Sao_Paulo.
TZ=America/Sao_Paulo

# --- Banco de dados (PostgreSQL) ---
# Local: as duas URLs podem ser iguais.
# Vercel + integração Neon (prefixo "DATABASE"): as duas são criadas sozinhas.
#   DATABASE_URL          = conexão COM pooling (aplicação)
#   DATABASE_URL_UNPOOLED = conexão SEM pooling (migrações)
DATABASE_URL=postgresql://gta:troque_esta_senha@localhost:5432/gta_store?schema=public
DATABASE_URL_UNPOOLED=postgresql://gta:troque_esta_senha@localhost:5432/gta_store?schema=public

# --- Mercado Pago (SOMENTE servidor) ---
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Produção: "Credenciais de produção" > Access Token (APP_USR-...).
# Testes: use as credenciais de TESTE (TEST-...) com usuários de teste.
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" exibida em Suas integrações > Webhooks (validada com o
# WebhookSignatureValidator do SDK oficial, com proteção contra replay).
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MAX_INSTALLMENTS=12
# Nome na fatura do cartão (até 22 caracteres, apenas letras/números/espaço).
MERCADOPAGO_STATEMENT_DESCRIPTOR=LOJA GAMES

# --- Checkout Transparente (pagamento dentro do site) ---
# Public Key de PRODUÇÃO (Credenciais de produção > Public Key). É pública por
# natureza. Se preenchida, ativa PIX e cartão dentro do site e tem prioridade
# sobre os links de pagamento. Exige ACCESS_TOKEN e WEBHOOK_SECRET de produção.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# --- Modo "link de pagamento" (opcional) ---
# Se preenchido, o botão de compra leva ao link do Mercado Pago (criado no app
# do Mercado Pago) em vez de usar a integração via API. Deixe vazio para usar a
# integração completa (pedidos no banco, confirmação automática no site).
# Recomendado: um link por plataforma.
MERCADOPAGO_PAYMENT_LINK_PS5=
MERCADOPAGO_PAYMENT_LINK_XBOX_SERIES=
# Link único (usado para plataformas sem link próprio).
MERCADOPAGO_PAYMENT_LINK=

# --- Anúncios (opcional) ---
# IDs públicos dos pixels. Só carregam após o visitante aceitar os cookies (LGPD).
# Meta: Gerenciador de Eventos > Fontes de dados > Pixel (só números).
NEXT_PUBLIC_META_PIXEL_ID=
# Código da meta tag de verificação de domínio da Meta (só o valor do "content").
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
# TikTok: Gerenciador de Anúncios > Ferramentas > Eventos > Web (letras e números).
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Dados públicos da loja (exibidos no site) ---
NEXT_PUBLIC_STORE_NAME=Loja de Games
NEXT_PUBLIC_STORE_LEGAL_NAME=
NEXT_PUBLIC_STORE_CNPJ=
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_STORE_EMAIL=
# Somente dígitos com DDI + DDD. Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=
