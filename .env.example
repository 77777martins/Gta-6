# =====================================================================
# Copie para .env (desenvolvimento) ou configure no provedor de deploy.
# NUNCA versione o arquivo .env. Apenas NEXT_PUBLIC_* chegam ao navegador.
# =====================================================================

# --- Aplicação ---
# URL pública do site (https obrigatório em produção). Usada nas back_urls do
# Mercado Pago e na proteção CSRF (validação de Origin).
APP_URL=http://localhost:3000

# Trava de vendas. Só mude para "true" após confirmar: disponibilidade comercial,
# autorização para revenda, plataformas oficiais e dados legais da loja.
SALES_ENABLED=false

# Fuso horário do processo (logs/datas do servidor). A interface já formata
# datas explicitamente em America/Sao_Paulo.
TZ=America/Sao_Paulo

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL=postgresql://gta:troque_esta_senha@localhost:5432/gta_store?schema=public

# --- Mercado Pago (SOMENTE servidor) ---
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Produção: "Credenciais de produção" > Access Token (APP_USR-...).
# Testes: use as credenciais de TESTE (TEST-...) com usuários de teste.
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" exibida em Suas integrações > Webhooks (validada com o
# WebhookSignatureValidator do SDK oficial, com proteção contra replay).
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MAX_INSTALLMENTS=12
# Nome na fatura do cartão (até 22 caracteres, apenas letras/números/espaço).
MERCADOPAGO_STATEMENT_DESCRIPTOR=LOJA GAMES

# --- Dados públicos da loja (exibidos no site) ---
NEXT_PUBLIC_STORE_NAME=Loja de Games
NEXT_PUBLIC_STORE_LEGAL_NAME=
NEXT_PUBLIC_STORE_CNPJ=
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_STORE_EMAIL=
# Somente dígitos com DDI + DDD. Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=
