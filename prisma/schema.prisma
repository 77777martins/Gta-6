// Modelagem de pedidos e pagamentos.
// Um pedido pode ter várias tentativas de pagamento (ex.: cartão recusado e
// depois PIX aprovado na mesma preferência do Checkout Pro). Por isso os
// pagamentos ficam em tabela própria e o status do pedido é DERIVADO deles.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: conexão com pooling (usada pela aplicação, ideal para serverless).
// DATABASE_URL_UNPOOLED: conexão direta, sem pooler (usada apenas nas migrações).
// Os dois nomes são os criados automaticamente pela integração Neon da Vercel
// (com prefixo "DATABASE").
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum OrderStatus {
  PENDING       // pedido criado, aguardando pagamento
  APPROVED      // pagamento aprovado e validado no backend
  REJECTED      // todas as tentativas recusadas
  CANCELLED     // pagamento cancelado/expirado
  REFUNDED      // estornado
  CHARGED_BACK  // contestação (chargeback)
}

enum Platform {
  PS5
  XBOX_SERIES
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  // Chave gerada no navegador por tentativa de checkout: impede pedidos duplicados
  // em duplo clique, reenvio ou retry de rede.
  idempotencyKey String      @unique @db.VarChar(64)

  customerName   String      @db.VarChar(120)
  customerEmail  String      @db.VarChar(254)
  customerCpf    String      @db.Char(11)
  customerPhone  String?     @db.VarChar(11) // DDD + número, só dígitos (opcional)
  platform       Platform

  productSku     String      @db.VarChar(64)
  productName    String      @db.VarChar(160)
  unitPriceCents Int
  quantity       Int         @default(1)
  totalCents     Int
  currency       String      @default("BRL") @db.Char(3)

  status         OrderStatus @default(PENDING)
  mpPreferenceId String?     @unique @db.VarChar(128)
  mpCheckoutUrl  String?     @db.VarChar(512)
  // Hash (não reversível) da credencial que criou a preferência. Se a credencial
  // mudar (ex.: teste -> produção), o link antigo não é reaproveitado.
  mpCredentialFp String?     @db.VarChar(16)
  paidAt         DateTime?
  fulfilledAt    DateTime?   // preenchido quando a equipe entregar o produto

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  payments       Payment[]

  @@index([customerEmail, createdAt])
  @@index([status, createdAt])
}

model Payment {
  // ID do pagamento no provedor: Mercado Pago (numérico) ou Pixoupay (UUID).
  id                String   @id @db.VarChar(64)
  // "mercadopago" | "pixoupay"
  provider          String   @default("mercadopago") @db.VarChar(16)
  orderId           String   @db.Uuid
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  status            String   @db.VarChar(32)
  statusDetail      String?  @db.VarChar(64)
  paymentMethodId   String?  @db.VarChar(32)
  paymentTypeId     String?  @db.VarChar(32)
  amountCents       Int
  currency          String   @db.Char(3)
  // false quando valor/moeda não batem com o pedido: nunca aprova o pedido.
  amountMatches     Boolean
  mpDateApproved    DateTime?
  mpDateLastUpdated DateTime?
  // PIX do Pixoupay: a consulta de status não devolve o QR Code, então ele é
  // guardado na criação para reaproveitar a mesma cobrança (sem duplicar).
  pixCode           String?
  pixQrBase64       String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([provider])
}
