{
  "name": "gta6-store",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page de vendas com checkout Mercado Pago (PIX e cartão), webhook validado e registro de pedidos.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@prisma/client": "~6.19.3",
    "next": "~15.5.29",
    "react": "~19.1.10",
    "react-dom": "~19.1.10",
    "react-hook-form": "^7.62.0",
    "server-only": "^0.0.1",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "~4.1.18",
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "~15.5.29",
    "prisma": "~6.19.3",
    "tailwindcss": "~4.1.18",
    "typescript": "~5.9.3",
    "vitest": "~3.2.7"
  }
}
